# ─── Compliance Review configuration ───────────────────────────────────────
# Copy to .env and fill in. Generate secrets with:  python -m app.cli gen-secrets

# development | production. Production refuses to start without SECRET_KEY + VAULT_KEY,
# turns on secure cookies + HSTS + JSON logs, and disables dev tools & demo users.
APP_ENV=production

# Where SQLite + (optional) key files live. Mount this as a persistent volume.
DATA_DIR=/data
# DATABASE_PATH=/data/app.db

# Session-cookie signing key (>= 32 chars).
SECRET_KEY=
# Fernet key(s) for the PII vault. Comma-separate to rotate: NEW,OLD  (then run `python -m app.cli rotate-vault`).
# LOSING THIS KEY MAKES ALL STORED CLIENT PII UNRECOVERABLE. Keep it in a secret manager.
VAULT_KEY=
# ...or point at a file instead (e.g. a mounted Docker/K8s secret):
# VAULT_KEY_FILE=/run/secrets/vault_key

# First admin account, created on startup if it does not exist (then remove the password from env).
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ─── LLM ───────────────────────────────────────────────────────────────────
# mock = deterministic offline model (demo).  openai = any OpenAI-compatible API.
LLM_PROVIDER=mock
# LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# schema = strict JSON schema output; object = JSON mode; none = prompt-only (validator still enforces grounding)
# LLM_JSON_MODE=schema
# LLM_TIMEOUT=30
# local (default, calibrated) | remote (re-tune data/disclosures.json max_distance with `npm run eval`)
# EMBEDDINGS_PROVIDER=local
# EMBEDDING_MODEL=text-embedding-3-small

# ─── Optional ──────────────────────────────────────────────────────────────
# DEV_TOOLS=false            # payload viewer + fault simulation (on by default in development)
# SEED_DEMO_USER=false       # demo logins sarah/admin (development only)
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=true         # set false only if you serve over plain HTTP on localhost
# MAX_UPLOAD_MB=15
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=300
# USE_PRESIDIO=true
# SPACY_MODEL=en_core_web_sm
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (default) lives in DATA_DIR. For several replicas or dedicated workers use Postgres:
# DATABASE_URL=postgresql://compliance:password@db:5432/compliance
# POSTGRES_PASSWORD=          # used by docker-compose.postgres.yml

# ─── Background analysis ───────────────────────────────────────────────────
# WORKER_THREADS=2            # analysis threads inside the web process; 0 when running `python -m app.worker`

# ─── OCR (scanned PDFs and images) ─────────────────────────────────────────
# OCR_ENABLED=true            # needs Tesseract (included in the Docker image)
# OCR_LANG=eng
# TESSERACT_CMD=              # path to tesseract if it is not on PATH

# ─── Sign-in ───────────────────────────────────────────────────────────────
# MFA_REQUIRED=false          # local accounts must enrol an authenticator app (TOTP)
# LOCAL_LOGIN_ENABLED=true    # set false to allow SSO only
# Single sign-on (OpenID Connect): Okta, Entra ID, Google Workspace, Auth0, Keycloak...
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://review.example.com/api/auth/oidc/callback   # default: derived from the request
# OIDC_SCOPES=openid email profile
# OIDC_ROLE_CLAIM=groups
# OIDC_ADMIN_VALUES=compliance-admins       # claim values that grant the admin role
# OIDC_ALLOWED_DOMAINS=example.com          # optional email-domain allow-list
# OIDC_AUTO_PROVISION=true
# OIDC_LABEL=Sign in with Okta
